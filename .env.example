# Telegram. BOT_TOKEN may be reused; CHAT_ID should point to the new channel.
BOT_TOKEN=
CHAT_ID=
BOT_LABEL=robinhood-chain-signal-bot

# Robinhood Chain mainnet.
NETWORK=robinhood
CHAIN_NAME=Robinhood Chain
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com
DEXSCREENER_CHAIN=robinhood
GT_WEB_NETWORK=robinhood
GMGN_REFERRAL_CODE=gC9GHIgN
FOMO_CHAIN=robinhood
FOMO_REFERRAL_CODE=WarmFineHare

# On-chain discovery. GeckoTerminal is enrichment-only by default.
POLL_SECONDS=60
GT_MIN_INTERVAL=7
ENABLE_CHAIN_WATCH=true
ENABLE_GECKO_DISCOVERY=false
CHAIN_CONFIRMATIONS=3
CHAIN_INITIAL_LOOKBACK=180
CHAIN_LOG_CHUNK=900
CHAIN_MAX_REPLAY=5400
ENRICH_BATCH_SIZE=30
V4_REQUIRE_SAME_TX_MINT=true
ENABLE_PONS_SCANNER=true
PONS_INITIAL_LOOKBACK=180
PONS_MAX_RESERVE_CURVES=10
GT_RETRIES=1
TRENDING_EVERY_N_TICKS=0
WATCHLIST_REFRESH=0
ENABLE_MOMENTUM_ALERTS=false

# Conservative initial filters; recalibrate after collecting outcomes.
NEW_LAUNCH_MIN_LIQ=15000
NEW_LAUNCH_MAX_AGE_H=6
MIN_LIQ_USD=10000
MIN_VOL_1H_USD=5000
MIN_VELOCITY=0.15
MIN_CHG_1H=3
MAX_DUMP_5M=-20
MAX_CHG_1H=900
SCORE_THRESHOLD=6

# HyperEVM-specific inherited modules remain off across mixed DEX types.
ENABLE_LAUNCHPAD_WATCH=false
ENABLE_SCANNER=false
ENABLE_SAFETY=false
