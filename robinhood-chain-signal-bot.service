[Unit]
Description=Robinhood Chain launch + momentum signal bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/cheng/robinhood-chain-signal-bot
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 30 ]; do getent hosts api.telegram.org >/dev/null 2>&1 && break; i=$((i+1)); sleep 2; done; exit 0'
ExecStart=/usr/bin/python3 /home/cheng/robinhood-chain-signal-bot/run.py
Restart=always
RestartSec=15
RuntimeMaxSec=86400
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robinhood-chain-signal-bot

[Install]
WantedBy=default.target
